{
  "name": "prime-anime",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "test": "tsx --test src/lib/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build:web": "EXPO_NO_DOTENV=1 expo export --platform web --clear",
    "spike:anilist": "curl -sS -X POST https://graphql.anilist.co -H 'Content-Type: application/json' --data @spikes/anilist-query.json -o spikes/anilist-response.json && node spikes/analyze-anilist.mjs",
    "spike:annict": "bash spikes/run-annict.sh"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@react-native-async-storage/async-storage": "1.23.1",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-constants": "~17.0.0",
    "expo-font": "~13.0.4",
    "expo-linking": "~7.0.0",
    "expo-notifications": "~0.29.0",
    "expo-router": "~4.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.5",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "tsx": "^4.19.0",
    "typescript": "~5.6.0"
  }
}
