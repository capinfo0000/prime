{
  "expo": {
    "name": "アニメどこ見れ",
    "slug": "prime-anime",
    "scheme": "primeanime",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.primeanime"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#111827"
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "web": {
      "bundler": "metro",
      "output": "static",
      "name": "アニメどこ見れ",
      "shortName": "どこ見れ",
      "lang": "ja",
      "display": "standalone",
      "themeColor": "#010102",
      "backgroundColor": "#010102",
      "description": "今期プライムビデオ配信のアニメを更新曜日つきで一覧"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
