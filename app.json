{
  "expo": {
    "name": "アニメどこ見れ",
    "slug": "prime-anime",
    "scheme": "primeanime",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.primeanime"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#111827"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
